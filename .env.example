RELEASE_PERCENTAGE=85

# PostgreSQL connection string
# For Neon (neon.tech): postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# For local PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/hardfork_tracking?schema=public"

# Bearer token for CSV upload authentication
# In production, this should be fetched from GCP Secret Manager
CSV_UPLOAD_TOKEN="your-secret-token-here"

# Admit nodes with no block producer key into the dashboard table.
# Default (unset/false) shows one row per block producer. Set to "true" for
# networks where we run no block producers of our own (e.g. mainnet: archive +
# seeds), otherwise the table renders empty. Stake math is unaffected.
SHOW_NON_BP_NODES=false
