# =============================================================================
# Hardfork Tracker Configuration
# =============================================================================

# Hardfork tracker image (defaults to local build)
# Use a pre-built image: ghcr.io/o1-labs/hardfork-upgrade-tracking:latest
TRACKER_IMAGE=hardfork-tracker:local

# PostgreSQL connection string (defaults to local postgres service)
DATABASE_URL=postgresql://hardfork:hardfork@postgres:5432/hardfork_tracking

# Target percentage for upgrade completion on dashboard
RELEASE_PERCENTAGE=65

# Show nodes reporting no block producer key as their own dashboard rows.
# Default false = one row per block producer. Set true for networks where no
# block producers report (e.g. mainnet: archive + seeds), otherwise the table
# renders empty. Stake figures stay block-producer-only either way.
SHOW_NON_BP_NODES=false

# =============================================================================
# Mina Daemon Configuration (only used with --profile with-mina)
# =============================================================================

# Mina daemon Docker image
MINA_IMAGE=europe-west3-docker.pkg.dev/o1labs-192920/euro-docker-repo/mina-daemon:3.3.0-compatible-fed840d-noble-devnet

# Container platform - use linux/arm64 for Apple Silicon
MINA_PLATFORM=linux/amd64

# Mina peer list URL
MINA_PEER_LIST_URL=https://bootnodes.minaprotocol.com/networks/devnet.txt
